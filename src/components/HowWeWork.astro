---
import { howWeWork } from '../data/content';

/*
  New content, not part of the WordPress port. This four-step process
  existed in the original page source but carried elementor-hidden-desktop/
  tablet/mobile classes, so it never rendered on the live site — see
  PORTING-NOTES.md, "The hidden 'How We Work' section." Copy is the exact
  content preserved there ("Grid is 4 columns → 2 → 1").

  Styled to match the established system (section-pad, container-wide,
  eyebrow/heading/body pattern used by Services.astro/Contact.astro) rather
  than any Elementor markup, since none of that markup survived being hidden.
*/
---

<section class="section-pad">
  <div class="container-wide flex flex-col gap-[40px]">
    <div class="flex flex-col gap-[20px] lg:max-w-[60%]">
      <p
        class="font-sans text-[10px] font-semibold uppercase leading-[20px] tracking-[0.07rem] text-orange-500 md:text-[12px] md:leading-none md:tracking-[0.22em]"
      >
        {howWeWork.eyebrow}
      </p>
      <h2
        class="font-sans text-[30px] font-semibold leading-[40px] text-navy-700 md:text-[40px] md:leading-[50px] lg:text-[45px] lg:leading-[60px]"
      >
        {howWeWork.title}
      </h2>
      <p class="font-sans text-[16px] font-normal leading-[26px] text-[#686868] md:leading-[31px]">
        {howWeWork.body}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-[20px] md:grid-cols-2 lg:grid-cols-4">
      {
        howWeWork.steps.map((step) => (
          <div class="flex h-full flex-col gap-[10px] rounded-[8px] border border-[#E0E0E059] p-[20px] shadow-[0px_0px_10px_0px_rgba(0,0,0,0.05)] md:p-[25px]">
            <span class="font-sans text-[28px] font-bold leading-none text-[#E89A2E30]">
              {step.number}
            </span>
            <h3 class="font-sans text-[18px] font-semibold leading-[26px] text-navy-800">
              {step.title}
            </h3>
            <p class="font-sans text-[14px] font-normal leading-[24px] text-body">{step.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
