---
import { Image } from 'astro:assets';
import servicesImage from '../assets/services-solar.jpg';
import { services } from '../data/content';
import ServiceCard from './ServiceCard.astro';

/*
  Original: container 54b637e (column, 100px block padding, 1280px inner).
  Row a01c926 -> text column dd3a182 (70%) + image faa84de (30%), stacking at
  <=1024px. Card grid 13711a2: 3 cols -> 2 -> 1.
*/
---

<section id="services" class="section-pad">
  <div class="container-wide flex flex-col gap-[20px]">
    <div class="relative z-10 flex flex-col gap-[20px] lg:flex-row">
      <!-- The text column carries Elementor's default 10px container padding at desktop only. -->
      <div class="flex flex-col gap-[20px] lg:w-[70%] lg:p-[10px]">
        <p
          class="font-sans text-[10px] font-semibold uppercase leading-[20px] tracking-[0.07rem] text-orange-500 md:text-[12px] md:leading-none md:tracking-[0.22em]"
        >
          {services.eyebrow}
        </p>
        <h2
          class="max-w-full font-sans text-[30px] font-semibold leading-[40px] text-navy-700 md:text-[40px] md:leading-[50px] lg:max-w-[90%] lg:text-[45px] lg:leading-[60px]"
        >
          {services.title}
        </h2>
        <p class="font-sans text-[16px] font-normal leading-[26px] text-[#686868] md:leading-[31px]">
          {services.body}
        </p>
      </div>

      <!-- Column flex + justify-center matches Elementor; items-stretch would distort the aspect. -->
      <div class="flex flex-col justify-center lg:w-[30%]">
        <Image
          src={servicesImage}
          alt="Operator reviewing solar panel production data on a plant floor display"
          widths={[400, 800, 1200]}
          sizes="(min-width: 1025px) 30vw, 100vw"
          class="h-auto w-full rounded-[8px]"
          loading="lazy"
        />
      </div>
    </div>

    <!-- grid-template-rows: repeat(2, 1fr) in the original — rows share the tallest height. -->
    <div class="grid grid-cols-1 gap-[20px] [grid-template-rows:repeat(2,1fr)] md:grid-cols-2 lg:grid-cols-3">
      {services.items.map((item) => <ServiceCard {...item} />)}
    </div>
  </div>
</section>
