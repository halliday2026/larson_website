---
import { selfAssessment } from '../data/content';

/*
  New content, not part of the WordPress port — introduces the standalone
  self-assessment tool at public/assessment/larson-safety-risk-assessment.html.
  Styled to match the established design system (navy-800 section, same
  eyebrow/heading pattern as Contact.astro) rather than the original site,
  since the original never had this page.
*/
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}${selfAssessment.cta.href}`;
---

<section class="section-pad bg-navy-800">
  <div class="container-wide flex flex-col gap-[20px] lg:flex-row lg:items-center">
    <!-- Left: copy + category list -->
    <div class="flex flex-col gap-[20px] lg:w-3/5 lg:pr-[40px]">
      <p
        class="font-sans text-[10px] font-semibold uppercase leading-[20px] tracking-[0.07rem] text-orange-500 md:text-[12px] md:leading-none md:tracking-[0.22em]"
      >
        {selfAssessment.eyebrow}
      </p>
      <h2
        class="font-sans text-[30px] font-semibold leading-[40px] text-white md:text-[40px] md:leading-[50px] lg:text-[45px] lg:leading-[60px]"
      >
        {selfAssessment.title}
      </h2>
      <p class="font-sans text-[15px] font-normal leading-[25px] text-[#F1F1F1] md:text-[16px] md:leading-[31px]">
        {selfAssessment.body}
      </p>

      <ul class="grid grid-cols-1 gap-[12px] pt-[10px] sm:grid-cols-2">
        {
          selfAssessment.categories.map((category, i) => (
            <li class="flex items-center gap-[12px]">
              <span class="font-sans text-[13px] font-semibold text-orange-500">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="font-sans text-[14px] font-normal text-[#F1F1F1]">{category}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Right: stat trio + CTA card -->
    <div class="rounded-[8px] bg-[#152842] p-[20px] md:p-[35px] lg:w-2/5">
      <div class="grid grid-cols-3 gap-[10px] border-b border-[#2A3B52] pb-[24px]">
        {
          selfAssessment.facts.map((fact) => (
            <div class="text-center">
              <p class="font-sans text-[22px] font-bold leading-[28px] text-orange-500 md:text-[28px]">
                {fact.value}
              </p>
              <p class="mt-[4px] font-sans text-[11px] font-normal leading-[16px] text-[#C7D0D2]">
                {fact.label}
              </p>
            </div>
          ))
        }
      </div>

      <a
        href={href}
        target="_blank"
        rel="noopener"
        class="btn-lift mt-[24px] flex items-center justify-center gap-[10px] rounded-[4px] bg-orange-600 px-[30px] py-[18px] text-center font-sans text-[14px] font-medium uppercase leading-none text-black hover:text-white"
      >
        {selfAssessment.cta.label}
      </a>

      <p class="mt-[16px] text-center font-sans text-[12px] leading-[18px] text-[#8E9CA1]">
        Opens in a new tab · Your answers stay in your browser
      </p>
    </div>
  </div>
</section>
