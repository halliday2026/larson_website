---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import StatsBar from '../components/StatsBar.astro';
import SelfAssessment from '../components/SelfAssessment.astro';
import Services from '../components/Services.astro';
import HowWeWork from '../components/HowWeWork.astro';
import Industries from '../components/Industries.astro';
import WhyUs from '../components/WhyUs.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

/*
  Section order matches the original page, with two additions not present in
  the WordPress source: SelfAssessment and HowWeWork.

  HowWeWork revives the Elementor "How We Work" container (e11ea42), which
  carried elementor-hidden-desktop/-tablet/-mobile on the live WordPress site
  and so never rendered there — see PORTING-NOTES.md. It's live here per
  client request (2026-09-29).
*/
---

<Layout>
  <Header />
  <main id="main">
    <Hero />
    <StatsBar />
    <SelfAssessment />
    <Services />
    <HowWeWork />
    <Industries />
    <WhyUs />
    <Faq />
    <Contact />
  </main>
  <Footer />
</Layout>
