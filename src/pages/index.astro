---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import StatsBar from '../components/StatsBar.astro';
import Services from '../components/Services.astro';
import Industries from '../components/Industries.astro';
import WhyUs from '../components/WhyUs.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

/*
  Section order matches the original page. The Elementor "How We Work" container
  (e11ea42) is intentionally absent — it carries elementor-hidden-desktop,
  -tablet and -mobile on the live site, so it renders nowhere. Its content is
  preserved in PORTING-NOTES.md.
*/
---

<Layout>
  <Header />
  <main id="main">
    <Hero />
    <StatsBar />
    <Services />
    <Industries />
    <WhyUs />
    <Faq />
    <Contact />
  </main>
  <Footer />
</Layout>
